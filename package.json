    "pi-package",
    "pi",
    "pi-extension",
    "tui",
    "jobs",
    "processes",
    "systemd",
    "widget"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FurBlood344324/pi-live-jobs.git"
  },
  "homepage": "https://github.com/FurBlood344324/pi-live-jobs#readme",
  "bugs": {
    "url": "https://github.com/FurBlood344324/pi-live-jobs/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
